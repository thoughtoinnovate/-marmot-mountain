{
  "name": "marmot-mountain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @marmot/web",
    "build": "npm run build --workspace @marmot/web",
    "preview": "npm run preview --workspace @marmot/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "cap:sync": "npm run build && cap sync",
    "cap:android": "cap sync android",
    "cap:ios": "cap sync ios"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@eslint/js": "10.0.1",
    "@types/node": "24.10.1",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.0",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.1"
  }
}
